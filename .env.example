# Copy this file to `.env` and fill in secrets.
#   cp .env.example .env
# Never commit `.env` (it is gitignored).

# --- Required for live embed + chat (Steps 2–3+) ---
OPENAI_API_KEY=

# --- Models (defaults are fine for MVP) ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Voice input: gpt-4o-mini-transcribe | gpt-4o-transcribe | whisper-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=6
SIMILARITY_THRESHOLD=0.25

# --- Local paths ---
DATA_DIR=./data
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
COLLECTION_NAME=doccite_mvp

# --- Optional: outgoing mail (not used in Steps 0–6; parked for later) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true

# --- Step 7+ (backend / retention) ---
GUEST_INACTIVITY_TTL_HOURS=24
DATABASE_URL=sqlite:///./data/doccite.db
AUTH_SECRET=dev-change-me
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins for the Vite/Vercel frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preview deploys on Vercel (regex); set empty to disable
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
