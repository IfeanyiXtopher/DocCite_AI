# Copy this file to `.env` and fill in secrets.
#   cp .env.example .env
# Never commit `.env` (it is gitignored).

# --- Required for live embed + chat (Steps 2–3+) ---
OPENAI_API_KEY=

# --- Models (defaults are fine for MVP) ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=6
SIMILARITY_THRESHOLD=0.25

# --- Local paths ---
DATA_DIR=./data
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
COLLECTION_NAME=doccite_mvp

# --- Step 7+ (backend / retention) — not needed yet ---
# GUEST_INACTIVITY_TTL_HOURS=24
# DATABASE_URL=sqlite:///./data/doccite.db
# AUTH_SECRET=
